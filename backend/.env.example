# Copy to .env and fill in real values. This file is tracked as documentation
# only; never put real secrets here.
PORT=3001
BROWSER_SERVICE_URL=http://localhost:3002

# Shared secret used to authenticate server-to-server calls to the browser
# service's /render endpoint. Must match INTERNAL_TOKEN in browser-service/.env.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INTERNAL_TOKEN=c71c644e2b388fc6f52920bfda3644cd8104534d949680c6d297664c53e90d68

# --- Optional: rate limiting overrides (defaults shown) ---
# RATE_LIMIT_WINDOW_MS=60000
# RATE_LIMIT_SCRAPE=60
# RATE_LIMIT_EXTRACT=30
# RATE_LIMIT_CRAWL=10
# RATE_LIMIT_JOBS=120

# --- Optional: trust proxy setting ---
# Behind a TLS-terminating proxy (e.g. Render), set TRUST_PROXY=1 so rate
# limiting keys by the real client IP instead of the proxy's IP.
# TRUST_PROXY=1
